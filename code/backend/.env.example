# Backend Environment Variables
# Copy this file to .env and update values

# JWT Secret - USE A STRONG RANDOM STRING IN PRODUCTION (min 32 chars)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production

# MongoDB Connection String (Atlas or local)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/society_os?retryWrites=true&w=majority

# Server Port
PORT=5000

# Environment (development, production, test)
NODE_ENV=development

# Client URL for CORS (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173,http://localhost:3000

# MongoDB Connection Pool Settings
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=10

# Rate Limiting (requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX=10
PAYMENT_RATE_LIMIT_MAX=50
