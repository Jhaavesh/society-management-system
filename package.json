{
  "name": "society-os",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-society management platform",
  "workspaces": ["backend", "frontend/web-admin", "frontend/mobile-app"],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm --workspace backend run dev",
    "dev:web": "npm --workspace frontend/web-admin run dev",
    "dev:mobile": "npm --workspace frontend/mobile-app run dev",
    "build": "npm --workspace frontend/web-admin run build",
    "start": "npm --workspace backend start"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}